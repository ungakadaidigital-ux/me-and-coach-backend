# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_REF=xxxxx

# Auth — pseudo-email domain used to feed phone+password into Supabase Auth
# (see Design & Product Principles #1 — email auth is never shown to the user)
PSEUDO_EMAIL_DOMAIN=meandcoach.internal

# Manual account-creation phase — protects the internal admin routes
# support/admin uses to create coach accounts and reset passwords
# (Excel phone->password mapping model, no SMS/email dependency)
ADMIN_SECRET=change-me-to-a-long-random-string

# Frontend
FRONTEND_URL=http://localhost:5173

# WhatsApp (Wati)
WATI_API_ENDPOINT=
WATI_API_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

PORT=8080
